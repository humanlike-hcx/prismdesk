# PrismDesk 配置示例；复制为 .env 后填写模型服务配置。
ANTHROPIC_API_KEY=your_api_key
ANTHROPIC_MODEL=your_model_name
# 留空使用模型 SDK 默认地址；兼容服务请填写其 Anthropic 协议地址。
ANTHROPIC_BASE_URL=

# 意图识别 Embedding（OpenAI 兼容的 /embeddings 接口）
# 真实密钥只填写在本地 .env，不要提交。
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
EMBEDDING_MODEL=your_embedding_model
EMBEDDING_TIMEOUT_S=20
# 更换 Embedding 模型时使用新 collection，禁止混用不同向量空间。
RAG_COLLECTION_NAME=knowledge_base_qwen3_embedding_4b_v1
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
REDIS_PASSWORD=prismdesk123
REDIS_URL=redis://:prismdesk123@redis:6379/0
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
EVAL_BASELINE_PATH=/app/data/eval/baseline.json
PRISMDESK_SKILLS_DIR=./skills
PRISMDESK_SKILLS_MAX_PROMPT_CHARS=5000
# 本地演示可设为 false，跳过首次自动导入演示知识库；生产默认 true。
PRISMDESK_LOAD_DEFAULT_KB=true
PRISMDESK_COMPOSER_MAX_TOKENS=1000
PRISMDESK_COMPOSER_TEMPERATURE=0.1
PRISMDESK_TOOL_TRACE_MAX=200
# 可选：为各 Agent 指定模型；未配置时使用 ANTHROPIC_MODEL。
# PRISMDESK_GENERAL_MODEL=
# PRISMDESK_TECHNICAL_MODEL=
# PRISMDESK_BILLING_MODEL=
# PRISMDESK_ESCALATION_MODEL=
PROMETHEUS_PORT=9090
MONITOR_INTERVAL=10
GRAFANA_ADMIN_PASSWORD=prismdesk123
ALERT_WEBHOOK_URL=
